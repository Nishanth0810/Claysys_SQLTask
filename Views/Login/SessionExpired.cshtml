@{
    ViewData["Title"] = "SessionExpired";
    Layout = null;
}
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClaysysForms</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/UserLayout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Claysys_SQLTask.styles.css" asp-append-version="true" />
    <link href="~/css/userlayout.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>
<body>
    <style>
        body {
            background-color: #ffffff;
        }

        .card{
            border-color: #595959;
        }
       

    </style>
    <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
        <div class="session-container">
            <div class="card">
                <div class="card-header p-3 bg-danger text-bold text-white text-center">
                    Session Expired
                </div>
                <div class="card-body p-5">
                    Your session has been expired.Please login again.
                </div>
                <div class="card-footer text-end">
                    <a class="btn btn-danger" asp-controller="Login" asp-action="Login">Relogin</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


