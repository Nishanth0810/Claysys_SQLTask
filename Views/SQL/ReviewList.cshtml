 @model IEnumerable<Claysys_SQLTask.Models.SpReview>

@{
    ViewData["Title"] = "ReviewList";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var Tablevalues = ViewBag.TableName != null ? ViewBag.TableName.ToString().Split(',') : null;
    var Indexvalues = ViewBag.IndexName != null ? ViewBag.IndexName.ToString().Split(',') : null;

}
<h3 class="text-center mb-3">@ViewBag.SPName</h3>
<div class="container mt-4">
    <div class="row mb-2">
        <div class="col-md-6">
            @if (Tablevalues != null)
            {
                <h5 class="font-weight-bold mb-1">Relevant Tables:</h5>
                <ol class="list-group">

                    @for (int i = 0; i < Tablevalues.Length; i++)
                    {
                        <li class="list-group-item custom-list p-1">@Tablevalues[i]</li>
                    }

                </ol>
            }
        </div>

        <div class="col-md-6">
            @if (Indexvalues != null)
            {
                <h5 class="font-weight-bold mb-1 text-right">Relevant Indexes:</h5>
                <ol class="list-group">

                    @for (int i = 0; i < Indexvalues.Length; i++)
                    {
                        <li class="list-group-item custom-list text-right p-1">@Indexvalues[i]</li>
                    }

                </ol>
            }
        </div>
    </div>
</div>

<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<style>
    .custom-list {
        border: none;
    }

    .card-header {
        background-color: #f8f9fa;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }

    .form-check-input {
        margin-right: 0.5rem;
    }

    .form-check-label {
        font-weight: 500;
    }

    .form-check {
        margin-bottom: 0.5rem;
    }

    .card-body {
        padding: 1.25rem;
    }

    .card {
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
</style>

@foreach (var item in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="card-text"><strong>Assigned By - </strong> @item.AssignedBy</h6>
                </div>
                <div class="col-md-4">
                    <h6 class="card-text"><strong>Created By - </strong> @item.EmployeeName</h6>
                </div>
                <div class="col-md-4 text-md-right">
                    <h6 class="card-text"><strong>Created - </strong> @item.Created</h6>
                </div>
            </div>
            <div class="row mt-3">
                <p class="card-text"><strong>Description : </strong> @item.Description</p>
            </div>
        </div>
        <div class="card-footer py-1">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" name="QA" type="checkbox" data-id="@item.Id" @(item.IsMovedQA ? "checked" : "") />
                        <label class="form-check-label">
                            QA
                        </label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" name="UAT" type="checkbox" data-id="@item.Id" @(item.IsMovedUAT ? "checked" : "") />
                        <label class="form-check-label">
                            UAT
                        </label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-check">
                        <input class="form-check-input" name="PROD" type="checkbox" data-id="@item.Id" @(item.ISMovedPROD ? "checked" : "") />
                        <label class="form-check-label">
                            PROD
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('.form-check-input').change(function () {
            var checkbox = $(this);
            var id = checkbox.data('id');
            var fieldName = checkbox.attr('name');
            var isChecked = checkbox.is(':checked');

            $.ajax({
                url: '@Url.Action("ReviewMove", "SQL")',
                type: 'POST',
                data: {
                    id: id,
                    fieldName: fieldName,
                    value: isChecked
                },
                success: function (response) {
                    console.log('Update successful');
                },
                error: function (xhr, status, error) {
                    console.error('Update failed');
                }
            });
        });
    });
</script>